{
  "name": "yoinks-gui",
  "version": "0.1.0",
  "private": true,
  "description": "A beginner-friendly desktop GUI for yoinks",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsup",
    "start": "npm run build && electron .",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "dist:win": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "^34.0.0",
    "electron-builder": "^26.0.12",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "dev.forder.yoinks",
    "productName": "Yoinks GUI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true
    }
  },
  "overrides": {
    "yauzl": "^3.3.1"
  }
}
